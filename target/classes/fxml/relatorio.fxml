<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.mycompany.fintrack.controller.RelatorioController"
      spacing="10" alignment="CENTER">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>
    <Label text="Saldo Atual" style="-fx-font-size: 20px;"/>
    <Label fx:id="labelSaldo" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
    <Button text="Fechar" onAction="#fechar"/>
</VBox>