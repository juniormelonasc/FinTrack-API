<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.mycompany.fintrack.controller.MainController">
    <top>
        <HBox alignment="CENTER" spacing="20" style="-fx-background-color: #2c3e50; -fx-padding: 10;">
            <Label fx:id="tituloLabel" text="FinTrack" style="-fx-text-fill: white;"/>
        </HBox>
    </top>
    <center>
        <VBox spacing="10">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>
            <HBox spacing="10">
                <Button text="Nova Transação" onAction="#abrirNovaTransacao"/>
                <Button text="Relatório / Saldo" onAction="#abrirRelatorio"/>
                <Button text="Atualizar" onAction="#atualizarTabela"/>
                <Button text="Remover" onAction="#removerTransacao"/>
            </HBox>
            <TableView fx:id="tabelaTransacoes">
                <columns>
                    <TableColumn text="Data" fx:id="colData"/>
                    <TableColumn text="Descrição" fx:id="colDescricao"/>
                    <TableColumn text="Valor" fx:id="colValor"/>
                    <TableColumn text="Tipo" fx:id="colTipo"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>
        </VBox>
    </center>
</BorderPane>